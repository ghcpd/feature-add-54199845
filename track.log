  "arguments": "{\"path\": \"/tmp/bugbash_feature-add-54199845_claude-opus-4.6_c9qi57tx/repo/src/requests/_internal_utils.py\"}",
  "content": "1. \"\"\"\n2. requests._internal_utils\n3. ~~~~~~~~~~~~~~\n4. \n5. Provides utility functions that are consumed internally by Requests\n6. which depend on extremely few external helpers (such as compat)\n7. \"\"\"\n8. \n9. import re\n10. \n11. from .compat import builtin_str\n12. \n13. # RFC 7230 Section 3.2.6 defines token characters for header field names:\n14. #   token = 1*tchar\n15. #   tchar = \"!\" / \"#\" / \"$\" / \"%\" / \"&\" / \"'\" / \"*\" / \"+\"\n16. #         / \"-\" / \".\" / \"^\" / \"_\" / \"`\" / \"|\" / \"~\" / DIGIT / ALPHA\n17. _RFC7230_TOKEN_CHARS = r\"!#$%&'*+\\-.^_`|~0-9A-Za-z\"\n18. \n19. # Header name validation: strictly RFC 7230 token characters only.\n20. # This rejects non-token characters (e.g., control chars, spaces, colons)\n21. # that were previously loosely accepted.\n22. _VALID_HEADER_NAME_RE_BYTE = re.compile(\n23.     rb\"^[\" + _RFC7230_TOKEN_CHARS.encode(\"ascii\") + rb\"]+$\"\n24. )\n25. _VALID_HEADER_NAME_RE_STR = re.compile(\n26.     r\"^[\" + _RFC7230_TOKEN_CHARS + r\"]+$\"\n27. )\n28. \n29. # Header value validation: reject ASCII control characters (0x00-0x08,\n30. # 0x0A-0x1F, 0x7F) which can be used for header injection attacks.\n31. # The first character must also be a visible (non-whitespace) character.\n32. # Tab (0x09) is permitted within the value per RFC 7230 obs-text.\n33. _VALID_HEADER_VALUE_RE_BYTE = re.compile(\n34.     rb\"^[^\\x00-\\x20\\x7f][^\\x00-\\x08\\x0a-\\x1f\\x7f]*$|^$\"\n35. )\n36. _VALID_HEADER_VALUE_RE_STR = re.compile(\n37.     r\"^[^\\x00-\\x20\\x7f][^\\x00-\\x08\\x0a-\\x1f\\x7f]*$|^$\"\n38. )\n39. \n40. _HEADER_VALIDATORS_STR = (_VALID_HEADER_NAME_RE_STR, _VALID_HEADER_VALUE_RE_STR)\n41. _HEADER_VALIDATORS_BYTE = (_VALID_HEADER_NAME_RE_BYTE, _VALID_HEADER_VALUE_RE_BYTE)\n42. HEADER_VALIDATORS = {\n43.     bytes: _HEADER_VALIDATORS_BYTE,\n44.     str: _HEADER_VALIDATORS_STR,\n45. }\n46. \n47. \n48. def to_native_string(string, encoding=\"ascii\"):\n49.     \"\"\"Given a string object, regardless of type, returns a representation of\n50.     that string in the native string type, encoding and decoding where\n51.     necessary. This assumes ASCII unless told otherwise.\n52.     \"\"\"\n53.     if isinstance(string, builtin_str):\n54.         out = string\n55.     else:\n56.         out = string.decode(encoding)\n57. \n58.     return out\n59. \n60. \n61. def unicode_is_ascii(u_string):\n62.     \"\"\"Determine if unicode string only contains ASCII characters.\n63. \n64.     :param str u_string: unicode string to check. Must be unicode\n65.         and not Python 2 `str`.\n66.     :rtype: bool\n67.     \"\"\"\n68.     assert isinstance(u_string, str)\n69.     try:\n70.         u_string.encode(\"ascii\")\n71.         return True\n72.     except UnicodeEncodeError:\n73.         return False\n74. ",
