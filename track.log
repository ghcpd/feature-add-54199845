  "content": "1025.     Header names are validated against RFC 7230 token rules.\n1026.     Header values reject ASCII control characters (except tab) to\n1027.     prevent header injection attacks.\n1028. \n1029.     :param header: tuple, in the format (name, value).\n1030.     \"\"\"\n1031.     name, value = header\n1032.     _validate_header_part(header, name, 0)\n1033.     _validate_header_part(header, value, 1)\n1034. \n1035. \n1036. def _validate_header_part(header, header_part, header_validator_index):\n1037.     if isinstance(header_part, str):\n1038.         validator = _HEADER_VALIDATORS_STR[header_validator_index]\n1039.     elif isinstance(header_part, bytes):\n1040.         validator = _HEADER_VALIDATORS_BYTE[header_validator_index]\n1041.     else:\n1042.         raise InvalidHeader(\n1043.             f\"Header part ({header_part!r}) from {header} \"\n1044.             f\"must be of type str or bytes, not {type(header_part)}\"\n1045.         )\n1046. \n1047.     if not validator.match(header_part):\n1048.         header_kind = \"name\" if header_validator_index == 0 else \"value\"\n1049.         if header_validator_index == 0:\n1050.             raise InvalidHeader(\n1051.                 f\"Header {header_kind} must contain only RFC 7230 token \"\n1052.                 f\"characters (letters, digits, and !#$%&'*+-.^_`|~), \"\n1053.                 f\"got: {header_part!r}\"\n1054.             )\n1055.         raise InvalidHeader(\n1056.             f\"Invalid leading whitespace, control character(s), or return \"\n1057.             f\"character(s) in header {header_kind}: {header_part!r}\"\n1058.         )\n1059. \n1060. ",
